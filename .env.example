# Root build-time placeholders for the Android app.
# Copy values into your shell or pass as Gradle properties. Never commit real values.

# Deployed HTTPS origin of the AI I.Z identity API (no trailing slash).
AI_IZ_API_BASE_URL=

# Google OAuth 2.0 Web client ID used as the ID-token audience.
# Must match GOOGLE_OIDC_CLIENT_ID on the backend.
GOOGLE_WEB_CLIENT_ID=

# AI features currently use Firebase AI Logic; a separate GEMINI_API_KEY is not required for the default provider path.
