PORT=8090
NODE_ENV=development
# Dedicated isolated Runner database; never reuse legacy or production credentials.
DATABASE_URL=postgresql://runner_readonly:change-me@localhost:5432/ai_iz_runner
# Base origin of the deployed AI I.Z identity API.
AI_IZ_API_BASE_URL=https://identity.example.invalid
# Set true only after independently verifying database isolation.
RUNNER_DATABASE_ISOLATED=false

# Comma-separated AI I.Z user IDs allowed to inspect PostgreSQL schema metadata.
RUNNER_SCHEMA_USER_IDS=
