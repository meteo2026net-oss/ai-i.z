<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up device-bound encrypted credentials or linked account tokens. -->
        <exclude domain="sharedpref" path="metra_encrypted_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Prevent encrypted secrets from being transferred without their Keystore key. -->
        <exclude domain="sharedpref" path="metra_encrypted_vault.xml" />
    </device-transfer>
</data-extraction-rules>
